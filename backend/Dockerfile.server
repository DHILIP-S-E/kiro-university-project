# Plain web-server image for AWS App Runner (the existing Dockerfile is the Lambda one).
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY app app
COPY workers workers
COPY alembic alembic
COPY alembic.ini .

# App Runner sends traffic to this port and probes /health.
EXPOSE 8080

# Apply any pending migrations, then serve. Safe to repeat on every start.
CMD ["sh", "-c", "python -m alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8080 --proxy-headers"]
